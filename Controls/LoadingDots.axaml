<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PingPongDesktopApp.Controls.LoadingDots">

    <UserControl.Styles>
        <!--
            Three dots pulsing in sequence — the typing-indicator motif. Each
            runs the same cycle, offset so the pulse travels left to right.
        -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource Accent}"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <ScaleTransform/>
            </Setter>
        </Style>

        <Style Selector="Ellipse.dot.p1">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="0.4,0.0,0.2,1.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.dot.p2">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="INFINITE" Easing="0.4,0.0,0.2,1.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.dot.p3">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="INFINITE" Easing="0.4,0.0,0.2,1.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="7">
        <Ellipse Classes="dot p1"/>
        <Ellipse Classes="dot p2"/>
        <Ellipse Classes="dot p3"/>
    </StackPanel>
</UserControl>
