<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PingPongDesktopApp.App"
             xmlns:local="using:PingPongDesktopApp"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the Figma designs are light-only, and following the
                  system theme would put Fluent's dark palette behind them. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Controls.axaml"/>
        <StyleInclude Source="/Styles/Animations.axaml"/>
    </Application.Styles>
</Application>